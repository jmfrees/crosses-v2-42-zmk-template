#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,physical-layout = &gggw_crosses_42_layout; };

    combos {
        compatible = "zmk,combos";

        caps {
            bindings = <&caps_word>;
            key-positions = <28 31>;
        };

        studio {
            bindings = <&studio_unlock>;
            key-positions = <11 0>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "tap-preferred";
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "tap-preferred";
        };

        hmd: hmd {
            compatible = "zmk,behavior-hold-tap";
            label = "HMD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <200>;
            flavor = "tap-preferred";
        };

        shift_tap: shift_tap {
            compatible = "zmk,behavior-mod-morph";
            label = "SHIFT_TAP";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lt_shift_tap: lt_shift_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SHIFT_TAP";
            bindings = <&kp>, <&shift_tap>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    macros {
        bt_profile0: bt_profile0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
            label = "BT_PROFILE0";
        };

        bt_profile1: bt_profile1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
            label = "BT_PROFILE1";
        };

        bt_profile2: bt_profile2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
            label = "BT_PROFILE2";
        };

        bt_profile3: bt_profile3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
            label = "BT_PROFILE3";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &lt 6 Q          &kp W    &kp E    &kp R           &kp T                     &kp Y        &kp U         &kp I      &kp O    &kp P             &kp NON_US_BACKSLASH
&kp GRAVE  &hml LEFT_GUI A  &lt 3 S  &lt 4 D  &lt 2 F         &kp G                     &kp H        &kp J         &kp K      &kp L    &lt 3 SEMICOLON   &kp SQT
&kp LSHFT  &hml LCTRL Z     &kp X    &kp C    &mt LEFT_GUI V  &kp B                     &kp N        &kp M         &kp COMMA  &kp DOT  &hmr RCTRL SLASH  &kp RIGHT_SHIFT
                                     &mo 1    &kp SPACE       &lt_shift_tap LEFT_GUI 0  &lt 5 ENTER  &kp LEFT_ALT  &lt 3 ESC
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans  &studio_unlock  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans  &trans          &trans  &trans  &trans  &trans  &trans
                           &trans     &trans     &trans  &trans          &trans  &trans
            >;
        };

        movement_layer {
            display-name = "Movement";
            bindings = <
&trans     &trans            &trans          &trans     &trans      &trans       &trans    &trans         &trans       &trans     &trans  &trans
&trans     &kp LA(LEFT_ALT)  &kp LEFT_SHIFT  &kp LCTRL  &trans      &trans       &kp LEFT  &kp DOWN       &kp UP       &kp RIGHT  &trans  &trans
&kp LSHFT  &kp LCTRL         &trans          &trans     &kp K_COPY  &kp K_PASTE  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END    &trans  &trans
                                             &trans     &trans      &trans       &trans    &trans         &trans
            >;
        };

        symbols_layer {
            display-name = "Symbols";
            bindings = <
&kp TAB    &kp EXCL        &kp AT            &kp HASH              &kp DLLR               &kp PRCNT      &kp CARET  &kp AMPS   &kp RS(N8)  &kp LS(EQUAL)  &kp RPAR   &kp BSPC
&kp LCTRL  &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS      &kp MINUS  &kp EQUAL  &kp LBKT    &kp EQUAL      &kp COLON  &kp DOUBLE_QUOTES
&kp LSHFT  &kp LESS_THAN   &kp GREATER_THAN  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LS(MINUS)  &kp UNDER  &kp PLUS   &kp LBRC    &kp RBRC       &kp PIPE   &kp TILDE
                                             &trans                &trans                 &trans         &trans     &trans     &trans
            >;
        };

        numpad_layer {
            display-name = "Numpad";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N7  &kp N8  &kp N9  &kp MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N4  &kp N5  &kp N6  &kp PLUS   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp N1  &kp N2  &kp N3  &kp ENTER  &trans
                        &trans  &trans  &trans  &trans  &kp N0  &kp N0
            >;
        };

        func_layer {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
                        &trans  &trans  &trans  &trans  &trans  &trans
            >;

            label = "Func";
        };

        bt_layer {
            bindings = <
&trans  &trans      &trans  &studio_unlock  &trans  &bootloader     &bootloader  &trans        &trans        &trans        &trans        &trans
&trans  &trans      &trans  &trans          &trans  &trans          &trans       &bt_profile0  &bt_profile1  &bt_profile2  &bt_profile3  &trans
&trans  &bt BT_CLR  &trans  &trans          &trans  &bt BT_CLR_ALL  &trans       &trans        &trans        &trans        &trans        &trans
                            &trans          &trans  &trans          &trans       &trans        &trans
            >;
        };
    };
};
